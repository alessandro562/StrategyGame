# Iniettate automaticamente dall'integrazione Upstash su Vercel.
# In locale: copiare in .env.local con i valori presi dalla console Upstash.
#
# L'app accetta due nomenclature, perché cambiano a seconda di come è collegato
# il database: UPSTASH_REDIS_REST_* (integrazione Upstash classica) oppure
# KV_REST_API_* (Upstash dal marketplace Vercel). Ne basta una.
#
# Se mancano entrambe, in locale si usa uno store in memoria (un processo, non
# persistente); su Vercel l'app si rifiuta di partire, perché lì lo store in
# memoria perderebbe commit senza dirlo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Codice stanza atteso dalle API. Default: ritiro
NEXT_PUBLIC_ROOM_CODE=ritiro
