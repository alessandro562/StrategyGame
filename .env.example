# Iniettate automaticamente dall'integrazione Upstash del marketplace Vercel.
# In locale: copiare in .env.local con i valori del database Upstash.
# Se assenti, l'app usa uno store in memoria (solo dev, un processo, non persistente).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Codice stanza atteso dalle API. Default: ritiro
NEXT_PUBLIC_ROOM_CODE=ritiro
